<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#B88428" />
            <corners android:radius="100dp" />
            <stroke android:width="2dp" android:color="#FFE0A0" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#D6A84F" />
            <corners android:radius="100dp" />
            <stroke android:width="2dp" android:color="#F4D28C" />
        </shape>
    </item>
</selector>
