<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:fitsSystemWindows="true" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/practice_background"
    tools:context=".PracticeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/back_button_bg"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRACTICE DECK"
                        android:textColor="#7F8BA3"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Decode the signal"
                        android:textColor="#F4F7FC"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSpeedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/practice_panel"
                    android:gravity="center"
                    android:minWidth="72dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="20 WPM"
                    android:textColor="#D6A84F"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#151C2A"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="#283246"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    


<LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TRANSMIT THIS LETTER"
                            android:textColor="#7F8BA3"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/txtStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STREAK 0"
                            android:textColor="#8C7CF2"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="#F8FAFF"
                        android:textSize="76sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Tap short for a dot  •  hold for a dash"
                        android:textColor="#7F8BA3"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/signalPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#101722"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="#263145"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="22dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:id="@+id/waveform"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginEnd="30dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_margin="3dp" android:background="#344056" />
                        <View android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:layout_margin="3dp" android:background="#344056" />
                        <View android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_margin="3dp" android:background="#D6A84F" />
                        <View android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:layout_margin="3dp" android:background="#8C7CF2" />
                        <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="3dp" android:background="#D6A84F" />
                        <View android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:layout_margin="3dp" android:background="#8C7CF2" />
                        <View android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:layout_margin="3dp" android:background="#D6A84F" />
                        <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_margin="3dp" android:background="#344056" />
                    </LinearLayout>

                    <View
                        android:id="@+id/flashIndicator"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/indicator_off_modern" />

                    <TextView
                        android:id="@+id/txtSignalState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="READY"
                        android:textColor="#7F8BA3"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMorse"
                        android:layout_width="154dp"
                        android:layout_height="154dp"
                        android:layout_marginTop="15dp"
                        android:contentDescription="Morse input button. Tap for dot and hold for dash"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="TAP"
                        android:textColor="#111722"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/morse_tap_button"
                        app:backgroundTint="@null"
                        app:cornerRadius="77dp"
                        app:icon="@null" />

                    <TextView
                        android:id="@+id/txtPressTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="0 ms"
                        android:textColor="#7F8BA3"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#151C2A"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#283246"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="YOUR SIGNAL"
                            android:textColor="#7F8BA3"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/txtInputCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 marks"
                            android:textColor="#D6A84F"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/practice_panel"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#F4F7FC"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheck"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:text="CHECK SIGNAL"
                    android:textSize="12sp"
                    app:backgroundTint="#D6A84F"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="0.42"
                    android:text="CLEAR"
                    android:textSize="12sp"
                    android:textColor="#C6CEDD"
                    app:cornerRadius="18dp"
                    app:strokeColor="#3B465B" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:text="NEXT LETTER"
                android:textColor="#8C7CF2"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#111824"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#202B3D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEXT TO MORSE"
                        android:textColor="#7F8BA3"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="HELLO 123"
                        app:boxStrokeColor="#3B465B"
                        app:hintTextColor="#6F7B91">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:textColor="#F4F7FC"
                            android:textColorHint="#667188" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="#D6A84F"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayInput"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="PLAY CONVERTED SIGNAL"
                        android:textColor="#8C7CF2"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
