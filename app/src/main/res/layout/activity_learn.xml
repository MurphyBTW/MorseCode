<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/main_background"
    tools:context=".LearnActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- BACK -->

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/back_button_bg"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back"/>

            <!-- HEADER -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIGNAL LIBRARY"
                android:textColor="#FFB84D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Learn the language"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="18dp"
                android:text="Explore a signal and hear how it sounds."
                android:textColor="#A7B1C2"
                android:textSize="14sp"/>

            <!-- SIGNAL SELECTION -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardBackgroundColor="#E610141D"
                app:cardCornerRadius="20dp"
                app:strokeColor="#293140"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT SIGNAL SET"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14"/>

                    <!-- CATEGORY -->

                    <Spinner
                        android:id="@+id/spinnerCategory"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="8dp"
                        android:spinnerMode="dropdown"
                        android:theme="@style/ThemeOverlay.Material3.Dark"
                        android:popupBackground="#171C27"/>

                    <!-- SIGNAL -->

                    <Spinner
                        android:id="@+id/spinnerLetters"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:spinnerMode="dropdown"
                        android:theme="@style/ThemeOverlay.Material3.Dark"
                        android:popupBackground="#171C27"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CURRENT SIGNAL CARD -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#E6141822"
                app:cardCornerRadius="28dp"
                app:strokeColor="#5A4324"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT SIGNAL"
                        android:textColor="#A7B1C2"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"/>

                    <!--
                        Automatically resized in LearnActivity:
                        Letters/numbers = 64sp
                        Short words = 48sp
                        Medium words = 40sp
                        Prosign descriptions = 30sp
                    -->

                    <TextView
                        android:id="@+id/txtLetter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="A"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="64sp"
                        android:textStyle="bold"/>

                    <!-- MORSE CODE -->

                    <TextView
                        android:id="@+id/txtMorse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="22dp"
                        android:text=".-"
                        android:textColor="#FFB84D"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"/>

                    <!-- FLASH INDICATOR -->

                    <View
                        android:id="@+id/flashIndicator"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/indicator_off"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="LISTEN TO THE SIGNAL"
                        android:textColor="#A7B1C2"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PLAY -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_play_morse"
                android:textColor="#241507"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/btn_library_bg"
                app:backgroundTint="@null"
                app:cornerRadius="20dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>