<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10111D"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPETITIVE"
                android:textColor="#FFC45C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Trophy Hub"
                android:textColor="#FFF4DF"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Your ranked journey and competitive records."
                android:textColor="#91A0B5"
                android:textSize="14sp"/>

            <!-- CURRENT RANK -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="#202235"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR CURRENT RANK"
                    android:textColor="#AAB2C4"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtRankEmblem"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#343044"
                        android:gravity="center"
                        android:text="✦"
                        android:textColor="#FFC45C"
                        android:textSize="34sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtRank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unranked"
                            android:textColor="#FFF4DF"
                            android:textSize="23sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Signal Architect"
                            android:textColor="#91A0B5"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MMR"
                            android:textColor="#91A0B5"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/txtMmr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFC45C"
                            android:textSize="25sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- MATCH RECORD -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="MATCH RECORD"
                android:textColor="#FFC45C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <!-- WINS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="10dp"
                    android:background="#1A1C2B"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtWins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#66D9A5"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WINS"
                        android:textColor="#91A0B5"
                        android:textSize="11sp"/>

                </LinearLayout>

                <!-- LOSSES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="10dp"
                    android:background="#1A1C2B"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtLosses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FF7B83"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOSSES"
                        android:textColor="#91A0B5"
                        android:textSize="11sp"/>

                </LinearLayout>

                <!-- WIN RATE -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:background="#1A1C2B"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtWinRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#FFC45C"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WIN RATE"
                        android:textColor="#91A0B5"
                        android:textSize="11sp"/>

                </LinearLayout>

                <!-- CURRENT STREAK -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:background="#1A1C2B"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCurrentStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFC45C"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT STREAK"
                        android:textColor="#91A0B5"
                        android:textSize="11sp"/>

                </LinearLayout>

            </GridLayout>

            <!-- PERSONAL RECORDS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="PERSONAL RECORDS"
                android:textColor="#FFC45C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#1A1C2B"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Best win streak"
                    android:textColor="#91A0B5"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtBestStreak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0 wins"
                    android:textColor="#FFF4DF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#343748"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Best completion time"
                    android:textColor="#91A0B5"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtBestTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="No record yet"
                    android:textColor="#FFF4DF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- ====================================== -->
            <!-- TOP 10 LEADERBOARD -->
            <!-- ====================================== -->

            <LinearLayout
                android:id="@+id/leaderboardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LEADERBOARD"
                        android:textColor="#FFC45C"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Top 10 players ranked by MMR"
                        android:textColor="#91A0B5"
                        android:textSize="12sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtLeaderboardArrow"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="#FFC45C"
                    android:textSize="18sp"/>

            </LinearLayout>

            <!-- COLLAPSIBLE CONTENT -->

            <LinearLayout
                android:id="@+id/leaderboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- COLUMN HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="#202235"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:text="#"
                        android:textColor="#91A0B5"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PLAYER"
                        android:textColor="#91A0B5"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="MMR"
                        android:textColor="#91A0B5"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="WR"
                        android:textColor="#91A0B5"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- STATUS -->

                <TextView
                    android:id="@+id/txtLeaderboardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1A1C2B"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Tap to load leaderboard"
                    android:textColor="#91A0B5"
                    android:textSize="12sp"/>

                <!-- DYNAMIC PLAYER ROWS GO HERE -->

                <LinearLayout
                    android:id="@+id/leaderboardRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="#10111D"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⌂&#10;Home"
            android:textColor="#B7B7C8"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="♙&#10;Profile"
            android:textColor="#B7B7C8"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🏆&#10;Leaderboards"
            android:textColor="#FFC45C"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btnSettingsTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚙&#10;Settings"
            android:textColor="#B7B7C8"
            android:textSize="12sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>