<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Main content -->
    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="MORSECONNECT"
                        android:textColor="#FFF4DF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="learn it  •  tap it  •  hear it"
                        android:textColor="#91A0B5"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/signalLampHolder"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/pill_outline"
                    android:padding="12dp">

                    <View
                        android:id="@+id/signalLamp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/signal_lamp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Live signal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/pill_outline"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE SIGNAL"
                    android:textColor="#FFB84D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/signal_line" />

                <TextView
                    android:id="@+id/txtSignalCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="· · ·  — —  ·"
                    android:textColor="#D7DCE6"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Intro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Choose your station"
                android:textColor="#FFF4DF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Build your Morse skills through short lessons and quick challenges."
                android:textColor="#91A0B5"
                android:textSize="14sp" />

            <!-- Library Mode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLibrary"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/btn_library_bg"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="18dp"
                android:text="Library Mode"
                android:textAllCaps="false"
                android:textColor="#241507"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconGravity="textStart"
                app:iconPadding="14dp"
                app:iconTint="#241507" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-26dp"
                android:layout_marginEnd="20dp"
                android:gravity="end"
                android:text="A–Z  •  0–9  •  symbols"
                android:textColor="#6D4C29"
                android:textSize="10sp" />

            <!-- Quiz Mode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuiz"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/btn_quiz_bg"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="18dp"
                android:text="Quiz Mode"
                android:textAllCaps="false"
                android:textColor="#241507"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_help"
                app:iconGravity="textStart"
                app:iconPadding="14dp"
                app:iconTint="#241507" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-26dp"
                android:layout_marginEnd="20dp"
                android:gravity="end"
                android:text="streaks  •  speed  •  accuracy"
                android:textColor="#C0A7E9"
                android:textSize="10sp" />

            <!-- Daily Challenge -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDailyChallenge"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/btn_settings_bg"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="18dp"
                android:text="Daily Challenge"
                android:textAllCaps="false"
                android:textColor="#241507"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_today"
                app:iconGravity="textStart"
                app:iconPadding="14dp"
                app:iconTint="#241507" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-18dp"
                android:layout_marginEnd="20dp"
                android:gravity="end"
                android:text="daily warm-up  •  practice streak"
                android:textColor="#91A0B5"
                android:textSize="10sp" />

            <!-- Challenge Mode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChallenge"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/btn_library_bg"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="18dp"
                android:text="Challenge Mode"
                android:textAllCaps="false"
                android:textColor="#241507"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_send"
                app:iconGravity="textStart"
                app:iconPadding="14dp"
                app:iconTint="#241507" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-18dp"
                android:layout_marginEnd="20dp"
                android:gravity="end"
                android:text="ranked matches  •  rating  •  leaderboard"
                android:textColor="#6D4C29"
                android:textSize="10sp" />

            <!-- Morse signal legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_outline"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="DOT  ·"
                    android:textColor="#AEB8C8"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_outline"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="DASH  —"
                    android:textColor="#AEB8C8"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_outline"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="SIGNAL  ◉"
                    android:textColor="#AEB8C8"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="#10111D"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Home -->
        <TextView
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="⌂\nHome"
            android:textColor="#FFC45C"
            android:textSize="12sp" />

        <!-- Profile -->
        <TextView
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="♙\nProfile"
            android:textColor="#B7B7C8"
            android:textSize="12sp" />

        <!-- Leaderboards -->
        <TextView
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="🏆\nLeaderboards"
            android:textColor="#B7B7C8"
            android:textSize="12sp" />

        <!-- Settings -->
        <TextView
            android:id="@+id/btnSettingsTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="⚙\nSettings"
            android:textColor="#B7B7C8"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>