<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/main_background"
    tools:context=".QuizActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/back_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:contentDescription="Back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.10"
                        android:text="SIGNAL TEST"
                        android:textColor="#FFB84D"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Morse Quiz"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#352A50"
                    android:gravity="center"
                    android:minWidth="70dp"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="EASY"
                    android:textColor="#C8AEFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- PROGRESS ROW -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtQuestionProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Question 1 of 20"
                    android:textColor="#AAB4C8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score 0"
                    android:textColor="#FFB84D"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- QUESTION -->

            <TextView
                android:id="@+id/txtQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Which signal represents A?"
                android:textColor="#FFF4DF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- SIGNAL CARD -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#E6141822"
                app:cardCornerRadius="22dp"
                app:strokeColor="#353044"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="26dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="26dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="MORSE SIGNAL"
                        android:textColor="#77849A"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMorseDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:minHeight="50dp"
                        android:text=""
                        android:textColor="#FFB84D"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/flashIndicator"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/indicator_off" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ANSWERS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="SELECT YOUR ANSWER"
                android:textColor="#77849A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChoice1"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="10dp"
                android:text="CHOICE A"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#171B27"
                app:cornerRadius="16dp"
                app:strokeColor="#3B3555"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChoice2"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="10dp"
                android:text="CHOICE B"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#171B27"
                app:cornerRadius="16dp"
                app:strokeColor="#3B3555"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChoice3"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="10dp"
                android:text="CHOICE C"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#171B27"
                app:cornerRadius="16dp"
                app:strokeColor="#3B3555"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChoice4"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="18dp"
                android:text="CHOICE D"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#171B27"
                app:cornerRadius="16dp"
                app:strokeColor="#3B3555"
                app:strokeWidth="1dp" />

            <!-- PLAY -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:text="REPLAY MORSE"
                android:textColor="#FFB84D"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#1A1820"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_media_play"
                app:iconTint="#FFB84D"
                app:strokeColor="#6A5231"
                app:strokeWidth="1dp" />

            <!-- SUBMIT / NEXT -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelect"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="CHECK ANSWER"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#6F52A8"
                app:cornerRadius="18dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>